# Copy with: python scripts/init_env.py (generates every secret below; never commit .env).
# production: refuses to start with unsafe settings (see README "Ortam değişkenleri").
APP_ENV=production
LOG_LEVEL=INFO

POSTGRES_DB=relationships
POSTGRES_USER=relationships
POSTGRES_PASSWORD=
# Used only when running Python on the host; Compose sets its own DATABASE_URL.
DATABASE_URL=postgresql+psycopg://relationships:YOUR_PASSWORD@localhost:55432/relationships
DB_PORT=55432
API_PORT=8100
WEB_PORT=3100
# Private network IP of the server to share the panel; 127.0.0.1 keeps it on this machine.
PANEL_BIND=127.0.0.1

SECRET_KEY=
N8N_API_KEY=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
AUTH_REQUIRED=true
# true once the panel is served over HTTPS (required for network access).
COOKIE_SECURE=false
# Host names users type to reach the panel (DNS-rebinding guard), comma separated.
ALLOWED_HOSTS=localhost,127.0.0.1,backend,host.docker.internal
# Cross-origin browser apps allowed to call the API. Empty: same-origin panel only.
ALLOWED_ORIGINS=
ENABLE_API_DOCS=true

# Fictional demo data; must stay false in production.
ENABLE_DEMO_DATA=false
DEMO_MODE=false

# Live collection limits per job.
LIVE_SEARCH_ENABLED=true
SEARCH_BACKENDS=yahoo,duckduckgo,brave,google,mojeek,startpage
COLLECTION_MAX_SOURCES=500
# A job searches until it has the requested people, the user stops it or no new source is
# left; this is only a safety ceiling (the single worker runs one job at a time).
COLLECTION_TIME_BUDGET_SECONDS=3600
# Pause before each query for a further result page (free engines block rapid queries).
SEARCH_PAUSE_SECONDS=2
# Minimum gap between first-page queries.
SEARCH_QUERY_INTERVAL_SECONDS=1
# Same-site team/staff pages followed from relevant pages without people, per job.
COLLECTION_MAX_FOLLOWED_LINKS=30
# Large staff and speaker lists can exceed 1 MiB.
FETCH_MAX_BYTES=3145728
COLLECTION_MAX_ATTEMPTS=2
SOURCE_TEXT_RETENTION_DAYS=90

# Optional: OpenAI for /ai endpoints (the pipeline never needs it).
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: Google Sheets export (OAuth client + refresh token with Sheets and Drive scopes).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
